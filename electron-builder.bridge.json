{
  "appId": "com.boracume.bridge",
  "productName": "Pop Connect",
  "artifactName": "Pop-Connect-Setup-${version}-${arch}.${ext}",
  "asar": true,
  "directories": {
    "output": "dist-bridge"
  },
  "files": [
    "electron/bridge-*.cjs",
    "electron/bridge-ui.html",
    "public/icon-512x512.png",
    "public/LOGOMARCA/Logo pop.png",
    "public/LOGOMARCA/ICONE DESKTOP.png"
  ],
  "extraResources": [
    {
      "from": "native-bridge",
      "to": "native-bridge",
      "filter": ["**/*"]
    }
  ],
  "extraMetadata": {
    "main": "electron/bridge-main.cjs",
    "type": "commonjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon-512x512.png",
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Pop Connect",
    "runAfterFinish": true
  },
  "mac": {
    "target": "dmg",
    "icon": "public/icon-512x512.png"
  },
  "linux": {
    "target": "AppImage",
    "icon": "public/icon-512x512.png"
  }
}
