{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "1.0.303",
  "description": "PopSystem - Sistema de gestao para estabelecimentos alimenticios",
  "author": "PopSystem Team",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build:prod && vercel --prod",
    "deploy:preview": "npm run build && vercel",
    "electron": "electron electron/main.js",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:8080 && electron electron/main.js\"",
    "build:electron": "npm run build && electron-builder",
    "dist:electron": "npm run build && electron-builder --publish=never",
    "pack:electron": "electron-builder --dir",
    "sync:electron-version": "node scripts/sync-electron-version.cjs",
    "set:release-version": "node scripts/set-release-version.cjs",
    "build:desktop-installer": "npm run sync:electron-version && npm run build:desktop && node scripts/build-desktop-installer.cjs",
    "test:menu-perf": "playwright test tests/menu-cart-perf.spec.ts",
    "test:checkout": "playwright test tests/checkout-pix.spec.ts tests/menu-addons-perf.spec.ts",
    "test:cmv": "esbuild src/utils/cmvCalculations.test.ts --bundle --platform=node --format=esm --outfile=/tmp/popsystem-cmv-test.mjs && node --test /tmp/popsystem-cmv-test.mjs",
    "test:finance": "esbuild tests/finance-module.unit.test.ts --bundle --platform=node --format=esm --outfile=/tmp/popsystem-finance-test.mjs && node --test /tmp/popsystem-finance-test.mjs",
    "test:team": "esbuild tests/team-attendance.unit.test.ts --bundle --platform=node --format=esm --outfile=/tmp/popsystem-team-test.mjs && node --test /tmp/popsystem-team-test.mjs",
    "test:fiscal": "deno test --no-check --allow-env --allow-run supabase/functions/nfce-operations/icms-engine.test.ts supabase/functions/nfce-operations/rtc-engine.test.ts supabase/functions/nfce-operations/index.test.ts supabase/functions/nfce-operations/schema-matrix.test.ts",
    "dist:bridge": "node scripts/build-bridge.cjs",
    "pack:bridge": "node scripts/build-bridge.cjs --dir",
    "nfce:validate": "node scripts/validate-nfce-schema.cjs"
  },
