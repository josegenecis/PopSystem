    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.53.0",
    "react-leaflet": "^4.2.1",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "sharp": "^0.33.5",
    "sonner": "^1.5.0",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "vaul": "^0.9.3",
    "xml-crypto": "^6.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.3.0",
    "@playwright/test": "^1.56.1",
    "@types/google.maps": "^3.55.12",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "body-parser": "^2.2.2",
    "concurrently": "^9.0.1",
    "cors": "^2.8.5",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "express": "^5.2.1",
    "globals": "^15.9.0",
    "lovable-tagger": "^1.1.7",
    "postcss": "^8.4.47",
    "rollup": "^4.52.5",
    "supabase": "^2.70.5",
    "tailwindcss": "^3.4.11",
    "terser": "^5.43.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "ws": "^8.19.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.boracume.desktop",
    "productName": "POPSYSTEM",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "POPSYSTEM",
      "icon": "public/LOGOMARCA/ICONE DESKTOP.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "public/LOGOMARCA/ICONE DESKTOP.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/LOGOMARCA/ICONE DESKTOP.png"
    }
  }
}
