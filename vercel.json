{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), payment=(self), geolocation=(self)"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/sw\\.js$",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, proxy-revalidate"
      },
      "dest": "/sw.js"
    },
    {
      "src": "^/manifest\\.json$",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, proxy-revalidate"
      },
      "dest": "/manifest.json"
    },
    {
      "src": "^/(.*)$",
      "has": [{ "type": "host", "value": "boracume.com" }],
      "status": 308,
      "dest": "https://popsystem.com.br/$1"
    },
    {
      "src": "^/(.*)$",
      "has": [{ "type": "host", "value": "www.boracume.com" }],
      "status": 308,
      "dest": "https://popsystem.com.br/$1"
    },
    {
      "src": "^/menu/(.+)$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": { "pre": "WhatsApp" }
        }
      ],
      "dest": "/api/share/menu?id=$1"
    },
    {
      "src": "^/menu/(.+)$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": { "pre": "facebookexternalhit" }
        }
      ],
      "dest": "/api/share/menu?id=$1"
    },
    {
      "src": "^/menu/(.+)$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": { "pre": "Facebot" }
        }
      ],
      "dest": "/api/share/menu?id=$1"
    },
    {
      "src": "^/menu/(.+)$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": { "pre": "Twitterbot" }
        }
      ],
      "dest": "/api/share/menu?id=$1"
    },
    {
      "src": "^/menu/(.+)$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": { "pre": "TelegramBot" }
        }
      ],
      "dest": "/api/share/menu?id=$1"
    },
    {
      "src": "^/menu/(.+)$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": { "pre": "LinkedInBot" }
        }
      ],
      "dest": "/api/share/menu?id=$1"
    },
    {
      "src": "^/menu/(.+)$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": { "pre": "Slackbot" }
        }
      ],
      "dest": "/api/share/menu?id=$1"
    },
    {
      "src": "^/menu/(.+)$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": { "pre": "Discordbot" }
        }
      ],
      "dest": "/api/share/menu?id=$1"
    },
    {
      "src": "^/menu-digital$",
      "has": [
        {
          "type": "query",
          "key": "userId"
        }
      ],
      "dest": "/api/share/menu"
    },
    { "src": "^/share/menu/(.+)$", "dest": "/api/share/menu?id=$1" },
    { "src": "^/share/track/(.+)$", "dest": "/api/share/track?id=$1" },
    { "src": "^/api/bridge/update/(.+)$", "dest": "/api/bridge/update/%5Basset%5D?asset=$1" },
    { "handle": "filesystem" },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
